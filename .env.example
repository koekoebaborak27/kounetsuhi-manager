# 環境変数の見本。実値を書いた .env はコミットしない（.gitignore で除外済み）。
# 追加したら、この見本にもキーと説明を 1 行足すこと。

# 画面操作テスト（Playwright）の接続先。未設定なら http://localhost:3000 を使う。
E2E_BASE_URL=http://localhost:3000

# 画面操作テストで使うログイン情報（テスト用アカウント。実アカウントを書かない）。
# E2E_USER_ID=testuser
# E2E_USER_PASSWORD=

# DB の接続文字列。開発では Docker の PostgreSQL（docker/docker-compose.yml）につなぐ。
# 本番（Supabase）の接続文字列は Vercel の環境変数にだけ設定し、手元の .env には書かない。
DATABASE_URL=postgresql://app:password@localhost:5432/kounetsuhi_dev

# ログインの仕組み（Better Auth）の設定。
# ログイン状態を守るための秘密の値。32 文字以上のランダムな文字列にする。作り方は README.md の「セットアップ」。
BETTER_AUTH_SECRET=
# アプリの URL。Google から戻ってくる先の URL を作るのに使う。開発では http://localhost:3000。
BETTER_AUTH_URL=http://localhost:3000

# Google ログインの OAuth クライアントの ID とシークレット。Google Cloud の「認証情報」で作ったものを入れる。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
